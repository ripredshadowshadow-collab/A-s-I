{
  "name": "God's Eye View",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "God's Eye View",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode"
      ]
    }
  }
}
